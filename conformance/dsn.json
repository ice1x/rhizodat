{
  "description": "Connection string parsing. Schemes match case-insensitively; user, password and path are percent-decoded; a repeated query parameter is an error. redacted masks the password and every query parameter whose name contains pass, secret, token, key or credential with ***. Errors never echo secrets.",
  "cases": [
    {
      "raw": "postgresql://app:s3cret@db.local:6432/orders?sslmode=require",
      "expect": {
        "store": "postgres",
        "transport": null,
        "host": "db.local",
        "port": 6432,
        "user": "app",
        "password": "s3cret",
        "path": "/orders",
        "database": "orders",
        "params": {
          "sslmode": "require"
        },
        "redacted": "postgresql://app:***@db.local:6432/orders?sslmode=require"
      }
    },
    {
      "raw": "postgres://localhost/app",
      "expect": {
        "store": "postgres",
        "transport": null,
        "host": "localhost",
        "port": 5432,
        "user": null,
        "password": null,
        "path": "/app",
        "database": "app",
        "params": {},
        "redacted": "postgres://localhost/app"
      }
    },
    {
      "raw": "postgresql:///app?host=/var/run/postgresql",
