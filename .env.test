# DSNs of the stores in compose.yaml. A variable set in the environment overrides its line.
DATORIUM_TEST_PG_DSN=postgresql://postgres:datorium@127.0.0.1:55440/datorium
DATORIUM_TEST_DREVO_BOLT=drevo+bolt://127.0.0.1:57687
DATORIUM_TEST_CLICKHOUSE_DSN=clickhouse://datorium:datorium@127.0.0.1:58123/datorium
DATORIUM_TEST_ICEBERG_REST_DSN=iceberg+rest://127.0.0.1:58181/?s3.endpoint=http://127.0.0.1:59000&s3.access-key-id=datorium&s3.secret-access-key=datorium-secret&s3.region=us-east-1&s3.path-style-access=true
